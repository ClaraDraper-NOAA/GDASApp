-

  # Observation Space (I/O)
  # -----------------------
  obs space:
    name: {{observation_from_jcb}}
    obsdatain:
      engine:
        type: H5File
        obsfile: "{{atmosphere_obsdatain_path}}/{{atmosphere_obsdatain_prefix}}{{observation_from_jcb}}{{atmosphere_obsdatain_suffix}}"
        missing file action: warn
      obsgrouping:
        group variables: ["stationIdentification"]
        sort variable: "pressure"
        sort order: "descending"
    obsdataout:
      engine:
        type: H5File
        obsfile: "{{atmosphere_obsdataout_path}}/{{atmosphere_obsdataout_prefix}}{{observation_from_jcb}}{{atmosphere_obsdataout_suffix}}"
    io pool:
      max pool size: 1
    simulated variables: [stationPressure, virtualTemperature, airTemperature, specificHumidity, windEastward, windNorthward]
    observed variables: [stationPressure, virtualTemperature, airTemperature, specificHumidity, windEastward, windNorthward]

  # Observation Operator
  # -------------------
  obs operator:
    name: Composite
    components:
    - name: SfcCorrected
      correction scheme to use: GSL
      station_altitude: height
      geovar_sfc_geomz: height_above_mean_sea_level_at_surface
      geovar_geomz: geopotential_height
      observed temperature variable: airTemperature
      observed specific humidity variable: specificHumidity
      variables:
      - name: stationPressure
    - name: VertInterp
      vertical coordinate: air_pressure
      observation vertical coordinate: pressure
      observation vertical coordinate group: MetaData
      interpolation method: log-linear
      variables:
      - name: virtualTemperature
      - name: airTemperature
      - name: specificHumidity
    - name: VertInterp
      vertical coordinate: air_pressure
      observation vertical coordinate: pressure
      observation vertical coordinate group: MetaData
      interpolation method: log-linear
      variables:
      - name: windEastward
      - name: windNorthward
      # 10 m wind reduction, as GSI setupw factw
      hofx scaling field: SurfaceWindScalingPressure
      hofx scaling field group: DerivedVariables

  # Linear Observation Operator
  # ---------------------------
  linear obs operator:
    name: Composite
    components:
    - name: Identity
      variables:
      - name: stationPressure
    - name: VertInterp
      variables:
      - name: virtualTemperature
      - name: airTemperature
      - name: specificHumidity
    - name: VertInterp
      variables:
      - name: windEastward
      - name: windNorthward
      hofx scaling field: SurfaceWindScalingPressure
      hofx scaling field group: DerivedVariables

  # Observation Pre Filters (QC)
  # ------------------------------

{% set temperature_variables = ['virtualTemperature', 'airTemperature'] %}
{% set mass_variables = ['stationPressure'] + temperature_variables + ['specificHumidity'] %}
{% set wind_variables = ['windEastward', 'windNorthward'] %}
{% set assim_variables = mass_variables + wind_variables %}
{% set mass_obstypes          = [120, 132] %}
{% set wind_obstypes          = [220, 221, 232] %}
{% set assim_obstypes         = mass_obstypes + wind_obstypes %}

  obs pre filters:

  # remove all records not in desired obs type from obs space
  # --------------------------------

  - filter: Perform Action
    where:
    - variable:
        name: ObsType/pressure # hard-coded, as files don't have ObsType/stationPressure
      is_not_in: {{ assim_obstypes | join(', ') }}
    action:
      name: reduce obs space

  # Re-accept desired variables and obs type combinations.
  # --------------------------------

  - filter: RejectList
    udescriptor: "reject_all"

{% for variables, obstypes in [(mass_variables, mass_obstypes), (wind_variables, wind_obstypes)] %}
  - filter: Perform Action
    filter variables:
{% for var in variables %}
    - name: {{ var }}
{% endfor %}
    where:
    - variable:
        name: ObsType/pressure
      is_in: {{ obstypes | join(', ') }}
    action:
      name: accept

{% endfor %}
  # Observation Prior Filters (QC)
  # ------------------------------

  obs prior filters:

  # stationPressure QC
  # ---------------------------------

  # dropsonde Ps is monitored in GSI (ps 132 iuse -1); drop surface pressure is type 182 in SFCSHP
  - filter: RejectList
    filter variables:
    - name: stationPressure
    where:
    - variable:
        name: ObsType/pressure
      is_in: 132

  - filter: RejectList
    filter variables:
    - name: stationPressure
    where:
    - variable:
        name: ObsValue/stationPressure
      maxvalue: 59999.99 # reject station pressures below 600 hPa, where the GSI error table
                         # has very large errors (no weight in the analysis)

  - filter: RejectList
    filter variables:
    - name: stationPressure
    where:
    - variable:
        name: QualityMarker/stationPressure
      is_not_in: 0-3

  - filter: RejectList
    filter variables:
    - name: stationPressure
    where:
    - variable:
        name: QualityMarker/height
      is_in: 7, 8, 10-14

  - filter: RejectList
    filter variables:
    - name: stationPressure
    where:
    - variable: MetaData/height
      value: is_not_valid

  # temperature QC
  # ---------------------------------

{% for var in temperature_variables %}
  - filter: RejectList
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/{{ var }}
      is_in: 8-15
      value: is_not_valid
    where operator: or

  - filter: RejectList
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/pressure
      is_in: 8-15

  - filter: Bounds Check
    filter variables:
    - name: {{ var }}
    minvalue: 100
    maxvalue: 400
{% endfor %}

  # humidity QC
  # ---------------------------------

  - filter: RejectList
    filter variables:
    - name: specificHumidity
    where:
    - variable: QualityMarker/specificHumidity
      is_in: 8-15
      value: is_not_valid
    where operator: or

  - filter: RejectList
    filter variables:
    - name: specificHumidity
    where:
    - variable: QualityMarker/pressure
      is_in: 8-15

  # wind QC
  # ---------------------------------

{% for var in wind_variables %}
  - filter: RejectList
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/{{ var }}
      is_in: 8-15
      value: is_not_valid
    where operator: or

  - filter: RejectList
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/pressure
      is_in: 8-15
{% endfor %}

  # variables for the surface wind scaling in the obs operator
  - filter: Variable Transforms
    Transform: SurfaceWindScalingPressure
    SkipWhenNoObs: false

  # reject obs above the highest model level (0.013 hPa)
  - filter: Bounds Check
    filter variables:
    - name: virtualTemperature
    - name: airTemperature
    - name: specificHumidity
    - name: windEastward
    - name: windNorthward
    test variables:
    - name: MetaData/pressure
    minvalue: 1.3

  # temporal thinning
  # ---------------------------------
  # TURN ON FOR TESTING l_closeobs=True (temporal filter, instead of error inflation)
  - filter: Temporal Thinning
    filter variables:
    - name: stationPressure
    - name: virtualTemperature
    - name: airTemperature
    - name: specificHumidity
    - name: windEastward
    - name: windNorthward
    category_variable:
      name: MetaData/stationIdentification
    records_are_single_obs: true
    min_spacing: PT6H
    seed_time: '{{ atmosphere_background_time_iso }}'
    action:
      name: reject

  # TURN OFF FOR TESTING, l_closeobs=False
  # order matters - compute duplicate check (here) then apply O-F check
  # using initial errors, then apply duplicate error inflation
  #- filter: Variable Assignment
  #  assignments:
  #  - name: ObsErrorFactorDuplicateCheck/stationPressure
  #    type: float
  #    function:
  #      name: ObsFunction/ObsErrorFactorDuplicateCheck
  #      options:
  #        use_air_pressure: false
  #        variable: stationPressure

  # error assignments
  # ---------------------------------

  # set initial errors, then save
  # ---------------------------------

  - filter: Perform Action
    filter variables:
    - name: stationPressure
    action:
      name: assign error
      error function:
        name: ObsFunction/ObsErrorModelStepwiseLinear
        options:
          round_to_the_nearest_integer: true
          xvar:
            name: ObsValue/stationPressure
          xvals: [80000, 75000, 60000]
          errors: [110, 120, 120]

  # order matters: before conversion to q units.
  - filter: RejectList
    filter variables:
    - name: specificHumidity
    where:
    - variable: ObsErrorData/specificHumidity
      value: is_not_valid

  # convert into specific humidity units, by *qsat_mod
  - filter: Variable Assignment
    assignments:
    - name: RelativeHumidityObsError/specificHumidity
      type: float
      source variable: ObsErrorData/specificHumidity

  - filter: Perform Action
    filter variables:
    - name: specificHumidity
    action:
      name: assign error
      error function:
        name: ObsFunction/ObsErrorSatSpecHumidity
        options:
          variable: specificHumidity
          input_error_name: RelativeHumidityObsError

{% for var in assim_variables %}
  - filter: Variable Assignment
    assignments:
    - name: InputObsError/{{ var }}
      type: float
      source variable: ObsErrorData/{{ var }}
{% endfor %}

  # apply error inflation terms
  # ---------------------------------

{% for var in assim_variables %}
  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/{{ var }}
      is_in: 3, 7
    action:
      name: inflate error
      inflation factor: 1.2
{% endfor %}

  - filter: Perform Action
    filter variables:
    - name: stationPressure
    action:
      name: inflate error
      inflation variable:
        name: ObsFunction/ObsErrorFactorSfcPressure
        options:
          geovar_sfc_geomz: height_above_mean_sea_level_at_surface
          geovar_geomz: geopotential_height
          station_altitude: height
          observed temperature variable: airTemperature
          observed specific humidity variable: specificHumidity

{% for var in temperature_variables %}
  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    where:
    - variable: MetaData/pressure
      maxvalue: 9999.0
    action:
      name: inflate error
      inflation factor: 1.2
{% endfor %}

  # order matters - Use the full T dry profile to compute error inflation (here)
  # then reject T dry where have T virtual, and additive inflation for below-surface.
  - filter: Variable Assignment
    assignments:
    - name: ErrormodFactor/airTemperature
      type: float
      function:
        name: ObsFunction/ObsErrorFactorConventional
        options:
          inflate variables: [airTemperature]
          pressure: MetaData/pressure

{% for var in temperature_variables %}
  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    action:
      name: inflate error
      inflation variable:
        name: ErrormodFactor/airTemperature
{% endfor %}

  # order matters - Use the full T dry profile to compute error inflation
  # then additive inflation for below-surface (here). 
{% for var in temperature_variables %}
  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    action:
      name: assign error
      error function:
        name: ObsFunction/Arithmetic
        options:
          variables:
          - name: ObsErrorData/{{ var }}
          - name: ObsFunction/ModelLevelsBelowSurface
          coefs: [1.0, 8.0]
{% endfor %}
 
  # humidity: profile spacing inflation (errormod)
  - filter: Perform Action
    filter variables:
    - name: specificHumidity
    action:
      name: inflate error
      inflation variable:
        name: ObsFunction/ObsErrorFactorConventional
        options:
          inflate variables: [specificHumidity]
          pressure: MetaData/pressure

  # order matters - apply the profile spacing inflation, then the minimum q error (here)
  - filter: Perform Action
    filter variables:
    - name: specificHumidity
    where:
    - variable: ObsErrorData/specificHumidity
      maxvalue: 1.0e-4
    action:
      name: assign error
      error parameter: 1.0e-4

  # order matters - compute the profile spacing inflation (which counts q obs below the surface as
  # neighbours, as GSI does), then reject q obs below the model surface (here). GSI instead adds 8
  # (in q units) per model level below the surface, which removes them from the analysis.
  - filter: Bounds Check
    filter variables:
    - name: specificHumidity
    test variables:
    - name: ObsFunction/ModelLevelsBelowSurface
    maxvalue: 0.0

  # wind: x1.2 above 50 hPa, and profile spacing inflation (errormod)
{% for var in wind_variables %}
  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    where:
    - variable: MetaData/pressure
      maxvalue: 4999.9
    action:
      name: inflate error
      inflation factor: 1.2
{% endfor %}

  - filter: Variable Assignment
    assignments:
    - name: ErrormodFactor/windEastward
      type: float
      function:
        name: ObsFunction/ObsErrorFactorConventional
        options:
          inflate variables: [windEastward]
          pressure: MetaData/pressure

{% for var in wind_variables %}
  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    action:
      name: inflate error
      inflation variable:
        name: ErrormodFactor/windEastward

  # order matters - do after the multiplicative error inflations
  # error += 4 m/s per model level below the model surface (GSI setupw rlow)
  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    action:
      name: assign error
      error function:
        name: ObsFunction/Arithmetic
        options:
          variables:
          - name: ObsErrorData/{{ var }}
          - name: ObsFunction/ModelLevelsBelowSurface
          coefs: [1.0, 4.0]
{% endfor %}

  # reduce to keep T virtual where present, otherwise Tdry. 
  # ----------------------------------

  # order matters - Use the full T dry profile to compute error inflation
  # then reject T dry where have T virtual (here)
  - filter: Perform Action
    filter variables:
    - name: airTemperature
    where:
    - variable: ObsValue/virtualTemperature
      value: is_valid
    action:
      name: reject

  # Observation Post Filters (QC)
  # -----------------------------

  obs post filters:

  # background checks
  # ---------------------------------

  - filter: Background Check
    filter variables:
    - name: stationPressure
    where:
    - variable: QualityMarker/stationPressure
      is_not_in: 3
    function absolute threshold:
    - name: ObsFunction/ObsErrorBoundConventional
      options:
        obsvar: stationPressure
        obserr_bound_min: 100
        obserr_bound_max: 300
        obserr_bound_factor: 5.0
    action:
      name: reject

  - filter: Background Check
    filter variables:
    - name: stationPressure
    where:
    - variable: QualityMarker/stationPressure
      is_in: 3
    function absolute threshold:
    - name: ObsFunction/ObsErrorBoundConventional
      options:
        obsvar: stationPressure
        obserr_bound_min: 100
        obserr_bound_max: 300
        obserr_bound_factor: 3.5
    action:
      name: reject

  # GSI gross check (convinfo: gross 8.0 for 120, 7.0 for 132, ermin 1.3, ermax 5.6, x0.7 for QM=3)
{% for var in temperature_variables %}
{% for obstype, gross, gross_qm3 in [(120, 8.0, 5.6), (132, 7.0, 4.9)] %}
  - filter: Background Check
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/{{ var }}
      is_not_in: 3
    - variable: ObsType/pressure
      is_in: {{ obstype }}
    function absolute threshold:
    - name: ObsFunction/ObsErrorBoundConventional
      options:
        obsvar: {{ var }}
        obserr_bound_min: 1.3
        obserr_bound_max: 5.6
        obserr_bound_factor: {{ gross }}
    action:
      name: reject

  - filter: Background Check
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/{{ var }}
      is_in: 3
    - variable: ObsType/pressure
      is_in: {{ obstype }}
    function absolute threshold:
    - name: ObsFunction/ObsErrorBoundConventional
      options:
        obsvar: {{ var }}
        obserr_bound_min: 1.3
        obserr_bound_max: 5.6
        obserr_bound_factor: {{ gross_qm3 }}
    action:
      name: reject
{% endfor %}
{% endfor %}

  # GSI gross check for q (convinfo: gross 8.0; gross*0.7 for QM=3)
  - filter: Background Check
    filter variables:
    - name: specificHumidity
    threshold: 8.0
    where:
    - variable: QualityMarker/specificHumidity
      is_not_in: 3
    action:
      name: reject

  - filter: Background Check
    filter variables:
    - name: specificHumidity
    threshold: 5.6
    where:
    - variable: QualityMarker/specificHumidity
      is_in: 3
    action:
      name: reject

  # GSI wind gross check on the vector residual (convinfo: gross 8.0, ermin 1.4, ermax 6.1;
  # gross*0.7 for QM=3)
{% for var in wind_variables %}
  - filter: Background Check
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/{{ var }}
      is_not_in: 3
    function absolute threshold:
    - name: ObsFunction/WindsSPDBCheck
      options:
        wndtype: [220, 221, 232]
        cgross: [8.0, 8.0, 7.0]
        error_min: [1.4, 1.4, 1.4]
        error_max: [6.1, 6.1, 6.1]
        variable: {{ var }}
    action:
      name: reject

  - filter: Background Check
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/{{ var }}
      is_in: 3
    function absolute threshold:
    - name: ObsFunction/WindsSPDBCheck
      options:
        wndtype: [220, 221, 232]
        cgross: [5.6, 5.6, 4.9]
        error_min: [1.4, 1.4, 1.4]
        error_max: [6.1, 6.1, 6.1]
        variable: {{ var }}
    action:
      name: reject
{% endfor %}

  # Apply duplicate error inflation
  # ---------------------------------

  # TURN OFF FOR TESTING l_closeobs=False (temporal filter, instead of error inflation)
  # order matters - compute duplicate check, then apply O-F check
  # using initial errors, then apply duplicate error inflation (here)
  #- filter: Perform Action
  #  filter variables:
  #  - name: stationPressure
  #  action:
  #    name: inflate error
  #    inflation variable:
  #      name: ObsErrorFactorDuplicateCheck/stationPressure

  # End of Filters

  # GeoVaLs for Driving Observation Operators (testing mode)
  # --------------------------------------------------------
  geovals:
    filename: "{{atmosphere_obsdatain_path}}/{{atmosphere_obsdatain_prefix}}{{observation_from_jcb}}_geoval{{atmosphere_obsdatain_suffix}}"

  # Passed benchmark for UFO testing
  # --------------------------------
  passedBenchmark: 0
