-

  # Observation Space (I/O)
  # -----------------------
  obs space:
    name: {{observation_from_jcb}}
    obsdatain:
      engine:
        type: H5File
        obsfile: "{{atmosphere_obsdatain_path}}/{{atmosphere_obsdatain_prefix}}{{observation_from_jcb}}{{atmosphere_obsdatain_suffix}}"
        missing file action: warn
    obsdataout:
      engine:
        type: H5File
        obsfile: "{{atmosphere_obsdataout_path}}/{{atmosphere_obsdataout_prefix}}{{observation_from_jcb}}{{atmosphere_obsdataout_suffix}}"
    io pool:
      max pool size: 1
    simulated variables: [windEastward, windNorthward]
    observed variables: [windEastward, windNorthward]

  # Observation Operator
  # --------------------
  obs operator:
    name: VertInterp
    vertical coordinate: geopotential_height
    observation vertical coordinate: adjustedHeight
    observation vertical coordinate group: DerivedVariables
    interpolation method: linear
    # 10 m wind reduction, as GSI setupw factw
    hofx scaling field: SurfaceWindScalingHeight
    hofx scaling field group: DerivedVariables

  # Linear Observation Operator
  # ---------------------------
  linear obs operator:
    name: VertInterp
    vertical coordinate: geopotential_height
    observation vertical coordinate: adjustedHeight
    observation vertical coordinate group: DerivedVariables
    interpolation method: linear
    hofx scaling field: SurfaceWindScalingHeight
    hofx scaling field group: DerivedVariables

  # Observation Pre Filters (QC)
  # ------------------------------

{% set wind_variables = ['windEastward', 'windNorthward'] %}

  obs pre filters:

  # remove all records not in desired obs type from obs space
  # --------------------------------

  - filter: Perform Action
    where:
    - variable:
        name: ObsType/windEastward
      is_not_in: 290
    action:
      name: reduce obs space

  - filter: Perform Action
    where:
    - variable: ObsValue/windEastward
      value: is_not_valid
    action:
      name: reduce obs space

  # Observation Prior Filters (QC)
  # ------------------------------

  obs prior filters:

  # wind QC
  # ---------------------------------

  # height relative to the model surface (10 m for ASCAT, with station elevation 0), returned above
  # mean sea level as the model heights are
  - filter: Variable Transforms
    Transform: AdjustedHeightCoordinate
    SkipWhenNoObs: false

  # variables for the surface wind scaling in the obs operator
  - filter: Variable Transforms
    Transform: SurfaceWindScalingHeight
    SkipWhenNoObs: false

  # GSI read_prepbufr: open water only (nearest surface type is water, skin temperature > 273 K)
  - filter: Bounds Check
    filter variables:
{% for var in wind_variables %}
    - name: {{ var }}
{% endfor %}
    test variables:
    - name: GeoVaLs/water_area_fraction
    minvalue: 0.999

  - filter: Bounds Check
    filter variables:
{% for var in wind_variables %}
    - name: {{ var }}
{% endfor %}
    test variables:
    - name: GeoVaLs/skin_temperature_at_surface
    minvalue: 273.0

  # thinning
  # ---------------------------------

  # GSI convinfo: ithin 1, rmesh 75 km, with one vertical bin (each file holds one satellite, which
  # GSI also thins separately)
  - filter: Gaussian Thinning
    filter variables:
{% for var in wind_variables %}
    - name: {{ var }}
{% endfor %}
    horizontal_mesh: 75
    use_reduced_horizontal_grid: true
    round_horizontal_bin_count_to_nearest: true
    partition_longitude_bins_using_mesh: true
    action:
      name: reject

  # error assignments
  # ---------------------------------

  # set initial errors
  # ---------------------------------

  # observation error: 2.5 m/s, the prepbufr error for type 290
  - filter: Perform Action
    filter variables:
{% for var in wind_variables %}
    - name: {{ var }}
{% endfor %}
    action:
      name: assign error
      error parameter: 2.5

  # apply error inflation terms
  # ---------------------------------

{% for var in wind_variables %}
  # error += 0.005 * model surface height (GSI setupw drpx; station height is zero for type 290)
  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    action:
      name: assign error
      error function:
        name: ObsFunction/Arithmetic
        options:
          variables:
          - name: ObsErrorData/{{ var }}
          - name: GeoVaLs/height_above_mean_sea_level_at_surface
          coefs: [1.0, 0.005]
          absolute value: [false, true]
{% endfor %}

  # Observation Post Filters (QC)
  # -----------------------------

  obs post filters:

  # background checks
  # ---------------------------------

  # GSI setupw: reject both components if either differs from the background by more than 5 m/s
  - filter: Bounds Check
    filter variables:
{% for var in wind_variables %}
    - name: {{ var }}
{% endfor %}
    test variables:
    - name: ObsFunction/Arithmetic
      options:
        variables:
        - name: ObsValue/windEastward
        - name: HofX/windEastward
        coefs: [1.0, -1.0]
    minvalue: -5.0
    maxvalue: 5.0

  - filter: Bounds Check
    filter variables:
{% for var in wind_variables %}
    - name: {{ var }}
{% endfor %}
    test variables:
    - name: ObsFunction/Arithmetic
      options:
        variables:
        - name: ObsValue/windNorthward
        - name: HofX/windNorthward
        coefs: [1.0, -1.0]
    minvalue: -5.0
    maxvalue: 5.0

  # GSI setupw: reject if the opposite wind vector is closer to the background
  - filter: Bounds Check
    filter variables:
{% for var in wind_variables %}
    - name: {{ var }}
{% endfor %}
    test variables:
    - name: ObsFunction/ScatWindsAmbiguityCheck
      options:
        minimum_uv: 0.0001
    maxvalue: 0.
    action:
      name: reject

  # GSI wind gross check on the vector residual (convinfo: gross 5.0, ermin 1.4, ermax 6.1)
{% for var in wind_variables %}
{% for cgross in [5.0] %}
  - filter: Background Check
    filter variables:
    - name: {{ var }}
    function absolute threshold:
    - name: ObsFunction/WindsSPDBCheck
      options:
        wndtype: [290]
        cgross: [{{ cgross }}]
        error_min: [1.4]
        error_max: [6.1]
        variable: {{ var }}
    action:
      name: reject
{% endfor %}
{% endfor %}
